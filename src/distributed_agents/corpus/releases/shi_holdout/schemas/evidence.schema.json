{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Shi holdout evidence record",
  "type": "object",
  "required": ["doc_id", "target_gene", "evidence_id", "evidence_slug", "description", "source_line", "source_report_sha256", "_source_record_sha256"],
  "properties": {
    "doc_id": {"type": "string", "minLength": 1},
    "target_gene": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "pattern": "^E[0-9]+$"},
    "evidence_slug": {"type": "string", "minLength": 1},
    "cell_type": {"type": ["string", "null"]},
    "genes": {"type": ["array", "null"], "items": {"type": "string"}},
    "statistics": {"type": ["string", "null"]},
    "description": {"type": "string"},
    "source_line": {"type": "integer", "minimum": 1},
    "source_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "_source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
