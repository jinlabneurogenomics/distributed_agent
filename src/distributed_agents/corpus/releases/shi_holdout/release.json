  "capabilities": {
    "skills": {
      "path": "skills",
      "version": "shi_holdout",
      "names": ["findings-ledger-skill", "findings-analysis-skill", "relational-candidate-skill", "biokg-recall-skill"],
      "roles": {
        "ledger": {
          "skill": "findings-ledger-skill",
          "entrypoints": {
            "query": "scripts/query_ledger.py",
            "calibration": "scripts/query_corpus.py",
            "read_reports": "scripts/read_reports.py",
            "resolve_evidence": "scripts/resolve_evidence.py"
          }
        },
        "analysis": {
          "skill": "findings-analysis-skill",
          "entrypoints": {"query": "scripts/query_ledger.py"}
        },
        "relational_candidates": {
          "skill": "relational-candidate-skill",
          "entrypoints": {
            "query": "scripts/relational_candidates.py",
            "predictive_review": "scripts/predictive_graph_review.py"
          }
        },
        "direct_evidence": {
          "skill": "relational-candidate-skill",
          "entrypoints": {"query": "scripts/direct_evidence.py"}
        },
        "graph": {
          "skill": "biokg-recall-skill",
          "entrypoints": {"query": "scripts/biokg_cypher.py"},
          "graph_contract": {
            "schema": {
              "node_labels": ["TargetGene", "Gene", "Finding", "Evidence", "Reference", "Claim"],
              "label_invariants": ["Every TargetGene node also has the Gene label."],
              "relationship_patterns": [
                "(TargetGene)-[:HAS_FINDING]->(Finding)",
                "(Finding)-[:HAS_TARGET]->(TargetGene)",
                "(Finding)-[:REPORTS_GENE]->(Gene)",
                "(Finding)-[:SUPPORTED_BY]->(Evidence)",
                "(Finding)-[:CITES]->(Reference)",
                "(Finding)-[:EXPRESSES_CLAIM]->(Claim)"
              ]
            },
            "canonical_target_expansion": {
              "query": "MATCH (t:TargetGene {symbol: $target})-[:HAS_FINDING]->(f:Finding)-[:REPORTS_GENE {role: 'finding_reported_comparator'}]->(g:Gene) RETURN f.doc_id AS finding_id, f.finding_type AS finding_type, g.symbol AS comparator, labels(g) AS comparator_labels ORDER BY finding_id, comparator LIMIT 50",
              "parameters": {"target": "Cplx1"}
            }
          }
        }
      }
    },
    "tooling": {
      "path": "tooling",
      "version": "shi_holdout",
      "entrypoints": ["read_reports.py", "query_ledger.py", "resolve_evidence.py"]
    },
    "projections": {
      "biokg": {"path": "projections/biokg", "version": "shi_holdout"}
    }
  },
  "integrity": {
    "target_membership": [
      {
        "artifacts": ["evidence", "references", "findings", "null_findings", "pathways", "cell_types", "claim_assignments", "claim_contributions", "finding_claim_dispositions"],
