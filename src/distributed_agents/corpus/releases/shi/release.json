  "capabilities": {
    "skills": {
      "path": "skills",
      "version": "shi",
      "names": [
        "findings-bm25-skill",
        "findings-ledger-skill",
        "findings-analysis-skill",
        "relational-candidate-skill",
        "biokg-recall-skill"
      ],
      "roles": {
        "lexical_retrieval": {
          "skill": "findings-bm25-skill",
          "entrypoints": {"query": "scripts/findings_bm25.py"}
        },
        "ledger": {
          "skill": "findings-ledger-skill",
          "entrypoints": {
            "query": "scripts/query_findings.py",
            "calibration": "scripts/query_corpus.py",
            "read_reports": "scripts/read_reports.py",
            "resolve_evidence": "scripts/resolve_evidence.py"
          }
        },
        "analysis": {
          "skill": "findings-analysis-skill",
          "entrypoints": {
            "cluster": "scripts/cluster_findings.py",
            "score": "scripts/score_findings.py"
          }
        },
        "relational_candidates": {
          "skill": "relational-candidate-skill",
          "entrypoints": {
            "query": "scripts/relational_candidates.py",
            "predictive_review": "scripts/predictive_graph_review.py"
          }
        },
        "graph": {
          "skill": "biokg-recall-skill",
          "entrypoints": {
            "query": "scripts/biokg_cypher.py",
            "offline_query": "scripts/query_biokg.py"
          }
        }
      }
    },
    "tooling": {
      "path": "tooling",
      "version": "shi",
      "entrypoints": ["read_reports.py", "query_findings.py", "resolve_evidence.py"]
    },
    "projections": {
      "biokg": {
        "path": "projections/biokg",
        "version": "shi"
      }
    }
  },
  "integrity": {
    "target_membership": [
      {
        "artifacts": ["findings", "evidence", "references"],
        "field": "target_gene",
        "reports_artifact": "reports",
        "report_field": "gene_target"
      }
    ],
    "joins": [
      {
        "from_artifacts": ["findings"],
        "field": "evidence_ids",
        "to_artifacts": ["evidence"],
        "to_field": "evidence_id",
        "scope_field": "target_gene"
      },
      {
        "from_artifacts": ["findings"],
        "field": "ref_ids",
        "to_artifacts": ["references"],
        "to_field": "ref_id",
        "scope_field": "target_gene"
      }
    ]
  }
