{
  "story_id": "S016",
  "title": "Hnrnpc reduction exposes a caudal and diencephalic splicing-speckle abundance response",
  "status": "grounded",
  "rejection_reason": null,
  "exact_observed_result": "Hnrnpc perturbation yielded FDR-supported responses in 8 of 22 assayed classes, strongest in 151 TH Prkcd Grin2c Glut and 155 MB Glut and recurring in 191 MB P MY GABA, 217 P MY Pineal Glut, 066 CNU-HYa HY GABA, 145 MH-LH TH Glut, 110 CNU-HYa HY MM Glut, and 052 Pvalb Gaba; Txnl1, Mterf3, Zbed4, Leng8, and Slc25a36 moved up while Luc7l2 moved down in the recurrent module.",
  "biological_interpretation": "HNRNPC lowering exposes a posterior/diencephalic RNA-processing abundance state, compatible with hnRNP control of alternative splicing and neurodevelopmental disease but resolved here as gene-level abundance changes rather than measured exon changes.",
  "targets": [
    "Hnrnpc"
  ],
  "cell_types": [
    "052 Pvalb Gaba",
    "066 CNU-HYa HY GABA",
    "110 CNU-HYa HY MM Glut",
    "145 MH-LH TH Glut"
  ],
  "support": {
    "source_findings": [
      {
        "target_gene": "Hnrnpc",
        "finding_id": "F001",
        "finding_type": "cell_type_selectivity",
        "direction": "response concentrated in 8 of 22 tested cell classes",
        "confidence": "high",
        "literature_status": "refines_cell_type_context",
        "summary": "Hnrnpc produced a caudal/diencephalic-biased abundance response rather than a pan-neuronal response.",
        "why_it_matters": "The main biological signal is not simply ubiquitous RNA-binding-protein toxicity; it is concentrated in thalamic, midbrain, hindbrain/pineal, hypothalamic, and Pvalb contexts while many cortical, hippocampal, and striatal classes were FDR-silent.",
        "n_genes": "0",
        "comparators": "005 L4-5 IT CTX Glut|054 CNU-MGE GABA|308 CB GABA",
        "cell_types": "151 TH Prkcd Grin2c Glut|155 MB Glut|191 MB P MY GABA|217 P MY Pineal Glut|066 CNU-HYa HY GABA|145 MH-LH TH Glut|110 CNU-HYa HY MM Glut|052 Pvalb Gaba",
        "n_cell_types": "8",
        "evidence_ids": "E002|E003|E004|E005|E006|E009|E011",
        "ref_ids": "R006|R007",
        "main_caveats": "Cell-type intrinsic selectivity is not separable from guide activity and power because Hnrnpc mRNA itself was weakly depleted."
      }
    ],
