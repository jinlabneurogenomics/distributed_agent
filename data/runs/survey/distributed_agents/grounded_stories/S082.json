{
  "story_id": "S082",
  "title": "CACNA1G loss creates a thalamic calcium-channel state that is orthogonal to CACNA1C and other Ca2+/calmodulin nodes",
  "status": "grounded",
  "rejection_reason": null,
  "exact_observed_result": "Cacna1g loss in 151 TH Prkcd Grin2c Glut produced a distinct FDR-supported thalamic calcium-channel state led by Ptprn, Iyd, Stmn4, Cpne7, Jun, Zdhhc22, and Lrrc7, and this state did not phenocopy Cacna1c, Cacna2d1, Cacnb4, Calm1/3, Camk2b, Ppp3ca, or Ppp3r1 perturbations.",
  "biological_interpretation": "A T-type calcium-channel perturbation elicits a selective thalamic RNA program that is separable from broader Ca2+/calmodulin network nodes in the same cell type.",
  "targets": [
    "Cacna1g",
    "Cacna1c",
    "Cacna2d1",
    "Cacnb4",
    "Ppp3ca"
  ],
  "cell_types": [
    "151 TH Prkcd Grin2c Glut"
  ],
  "support": {
