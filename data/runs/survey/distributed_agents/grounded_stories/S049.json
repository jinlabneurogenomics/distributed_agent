{
  "story_id": "S049",
  "title": "Celf2 loss collapses Celf-family RNA regulators in 151 TH neurons and broadly induces Snhg11 as a compact readout",
  "status": "grounded",
  "rejection_reason": null,
  "exact_observed_result": "Celf2 depletion was followed in 151 TH Prkcd Grin2c Glut by Celf1, Celf3, and Celf5 repression plus mixed synaptic output changes, while Snhg11 was FDR-significantly up in most measured Celf2 cell types, including compact Pvalb and midbrain signatures.",
  "biological_interpretation": "CELF2 maintains a local CELF-family RNA-regulatory state in thalamic neurons, and Snhg11 is a compact abundance reporter of CELF2 loss across classes with otherwise different response sizes.",
  "targets": [
    "Celf2",
    "Celf1",
    "Celf3",
    "Celf5",
    "Snhg11",
    "Kcnc2",
    "Syt7",
    "Vamp1"
  ],
  "cell_types": [
    "151 TH Prkcd Grin2c Glut",
    "052 Pvalb Gaba",
    "155 MB Glut",
    "191 MB P MY GABA",
    "217 P MY Pineal Glut"
  ],
