{
  "story_id": "S104",
  "title": "Ctcf loss selectively down-regulates clustered protocadherins in thalamic and midbrain glutamatergic neurons",
  "status": "grounded",
  "rejection_reason": null,
  "exact_observed_result": "Ctcf knockdown produced broad Pcdh-cluster repression in 151 TH Prkcd Grin2c Glut and 155 MB Glut, including Pcdhb20, Pcdhb17, Pcdhb16, Pcdhb18, Pcdhac1, Pcdha10, Pcdhgb2, and Pcdhga12, plus a smaller Ctcf-specific Zcwpw2-up and Dennd6b/Abhd14b/Rabggta-down core in additional neuronal classes.",
  "biological_interpretation": "The data align CTCF loss with known clustered-protocadherin locus control and refine it to selected thalamic and midbrain glutamatergic vulnerability in this screen.",
  "targets": [
    "Ctcf",
    "Pcdhb20",
    "Pcdhb17",
    "Pcdhb16",
    "Pcdhb18",
    "Pcdhac1",
    "Pcdha10",
    "Pcdhgb2",
    "Pcdhga12",
    "Zcwpw2",
    "Dennd6b",
    "Abhd14b"
  ],
